{
  "domain": "labels/v1",
  "producer": "example.com/app/cmd/settings",
  "package": {
    "name": "settings",
    "dir": "internal/settings"
  },
  "labels": [
    {
      "key": "settings.port",
      "text": "Listening port",
      "path": "server.port",
      "var": "Port"
    },
    {
      "key": "settings.host",
      "text": "Listening host",
      "path": "server.host",
      "var": "Host"
    }
  ]
}
