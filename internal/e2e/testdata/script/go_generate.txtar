# M5.5: genx under go generate, from a file of the root package. genx
# writes into other packages, so go generate's list of files stays right.
exec go generate ./...
exists internal/settings/zz_settings_consts.go
exec go build ./...

# A second go generate changes nothing.
exec go generate ./...
! stdout '^wrote '

-- gen.go --
package main

//go:generate genx

func main() {}
-- genx.yaml --
version: 1
producers:
  - name: settings
    run: [produce, data/labels.json, internal/settings/zz_settings.labels.json]
    emits: [internal/settings/zz_settings.labels.json]
use:
  - example.com/app/gen: [consts]
-- gen/gen.go --
package gen
-- gen/genx.meta.yaml --
version: 1
generators:
  consts:
    doc: constants
    needs: [labels/v1]
    units: '.["labels/v1"][] | {package}'
    out: '"\(.package.dir)/zz_\(.package.name)_consts.go"'
    template: consts.tmpl
-- gen/consts.tmpl --
// Code generated by test. DO NOT EDIT.

package {{.package.name}}
-- data/labels.json --
{"domain": "labels/v1", "producer": "p", "package": {"name": "settings", "dir": "internal/settings"}, "labels": []}
-- internal/settings/doc.go --
package settings
