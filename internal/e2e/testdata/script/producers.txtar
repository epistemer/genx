# M4.2: what genx checks about a producer.

# Its output is prefixed with its name; a failure names the producer and
# its command.
cp manifests/fails.yaml genx.yaml
! exec genx
cmp stderr want/fails.txt

# A declared file it didn't write.
cp manifests/missing.yaml genx.yaml
! exec genx
cmp stderr want/missing.txt

# A declared file that doesn't name its domain.
cp manifests/nodomain.yaml genx.yaml
! exec genx
cmp stderr want/nodomain.txt

# A domain in another major version than a generator needs.
cp manifests/major.yaml genx.yaml
! exec genx
cmp stderr want/major.txt

# A timeout.
cp manifests/slow.yaml genx.yaml
! exec genx
cmp stderr want/slow.txt

-- gen/gen.go --
package gen
-- gen/genx.meta.yaml --
version: 1

generators:
  read:
    doc: reads labels
    needs: [labels/v1]
    units: '{}'
    out: '"zz_out.go"'
    template: ok.tmpl
-- gen/ok.tmpl --
// Code generated by test. DO NOT EDIT.

package app
-- data/v2.json --
{"domain": "labels/v2", "producer": "new", "package": {"name": "a", "dir": "a"}, "labels": []}
-- data/plain.json --
{"labels": []}
-- manifests/fails.yaml --
version: 1
producers:
  - name: broken
    run: [fail, some, args]
    emits: [zz_x.labels.json]
-- manifests/missing.yaml --
version: 1
producers:
  - name: lazy
    run: [produce, data/plain.json, elsewhere.json]
    emits: [zz_x.labels.json]
-- manifests/nodomain.yaml --
version: 1
producers:
  - name: plain
    run: [produce, data/plain.json, zz_x.labels.json]
    emits: [zz_x.labels.json]
-- manifests/major.yaml --
version: 1
producers:
  - name: new
    run: [produce, data/v2.json, a/zz_a.labels.json]
    emits: [a/zz_a.labels.json]
use:
  - example.com/app/gen: [read]
-- manifests/slow.yaml --
version: 1
producers:
  - name: slow
    run: [sleepy, 30s]
    timeout: 200ms
    emits: [zz_x.labels.json]
-- want/fails.txt --
broken: failing: some args
genx: producer broken: fail some args: exit status 3
-- want/missing.txt --
genx: producer lazy: zz_x.labels.json: declared in emits, but the producer didn't write it
-- want/nodomain.txt --
genx: producer plain: zz_x.labels.json: no "domain" field (a foreign file needs "domain" in the manifest)
-- want/major.txt --
genx: example.com/app/gen:read needs labels/v1, but a/zz_a.labels.json from producer new says labels/v2; upgrade the module that writes it, or the one that reads it
-- want/slow.txt --
genx: producer slow: timed out after 200ms
