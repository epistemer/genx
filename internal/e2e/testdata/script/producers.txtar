# M4.2: what genx checks about a producer.

# Its output is prefixed with its name; a failure names the producer and
# its command.
cp manifests/fails.yaml genx.yaml
! exec genx
cmp stderr want/fails.txt

# A declared file it didn't write.
cp manifests/missing.yaml genx.yaml
! exec genx
cmp stderr want/missing.txt

# A declared file that doesn't name its domain.
cp manifests/nodomain.yaml genx.yaml
! exec genx
cmp stderr want/nodomain.txt

# A domain in another major version than a generator needs.
cp manifests/major.yaml genx.yaml
! exec genx
cmp stderr want/major.txt

# A timeout.
cp manifests/slow.yaml genx.yaml
! exec genx
cmp stderr want/slow.txt

# A producer runs in its dir; its emits stay relative to the module root.
cp manifests/indir.yaml genx.yaml
exec genx
exists sub/zz_x.labels.json
rm sub/zz_x.labels.json

# A command that isn't installed.
cp manifests/nocmd.yaml genx.yaml
! exec genx
cmp stderr want/nocmd.txt

# A declared file that isn't a JSON object.
cp manifests/array.yaml genx.yaml
! exec genx
cmp stderr want/array.txt

# Two producers that declare the same file.
cp manifests/twice.yaml genx.yaml
! exec genx
cmp stderr want/twice.txt

-- gen/gen.go --
package gen
-- gen/genx.meta.yaml --
version: 1

generators:
  read:
    doc: reads labels
    needs: [labels/v1]
    units: '{}'
    out: '"zz_out.go"'
    template: ok.tmpl
-- gen/ok.tmpl --
// Code generated by test. DO NOT EDIT.

package app
-- data/v2.json --
{"domain": "labels/v2", "producer": "new", "package": {"name": "a", "dir": "a"}, "labels": []}
-- data/plain.json --
{"labels": []}
-- manifests/fails.yaml --
version: 1
producers:
  - name: broken
    run: [fail, some, args]
    emits: [zz_x.labels.json]
-- manifests/missing.yaml --
version: 1
producers:
  - name: lazy
    run: [produce, data/plain.json, elsewhere.json]
    emits: [zz_x.labels.json]
-- manifests/nodomain.yaml --
version: 1
producers:
  - name: plain
    run: [produce, data/plain.json, zz_x.labels.json]
    emits: [zz_x.labels.json]
-- manifests/major.yaml --
version: 1
producers:
  - name: new
    run: [produce, data/v2.json, a/zz_a.labels.json]
    emits: [a/zz_a.labels.json]
use:
  - example.com/app/gen: [read]
-- manifests/slow.yaml --
version: 1
producers:
  - name: slow
    run: [sleepy, 30s]
    timeout: 200ms
    emits: [zz_x.labels.json]
-- data/array.json --
[]
-- sub/.keep --
-- manifests/indir.yaml --
version: 1
producers:
  - name: indir
    dir: sub
    run: [produce, ../data/sub.json, zz_x.labels.json]
    emits: [sub/zz_x.labels.json]
-- data/sub.json --
{"domain": "labels/v1", "producer": "indir", "package": {"name": "sub", "dir": "sub"}, "labels": []}
-- manifests/nocmd.yaml --
version: 1
producers:
  - name: absent
    run: [genx-no-such-command, gen]
    emits: [zz_x.labels.json]
-- manifests/array.yaml --
version: 1
producers:
  - name: list
    run: [produce, data/array.json, zz_x.labels.json]
    emits: [zz_x.labels.json]
-- manifests/twice.yaml --
version: 1
producers:
  - name: one
    run: [produce, data/plain.json, zz_x.labels.json]
    emits: [zz_x.labels.json]
  - name: two
    run: [produce, data/plain.json, zz_x.labels.json]
    emits: [zz_x.labels.json]
-- want/nocmd.txt --
genx: producer absent: genx-no-such-command gen: "genx-no-such-command" isn't installed, or isn't on PATH; install it, or run a module's tool with [go, tool, ...]
-- want/array.txt --
genx: producer list: zz_x.labels.json: not an object, so it can't name its domain (a foreign file needs "domain" in the manifest)
-- want/twice.txt --
genx: genx.yaml:8: producers[1].emits[0]: duplicate emit path "zz_x.labels.json" (also line 5)
-- want/fails.txt --
broken: failing: some args
genx: producer broken: fail some args: exit status 3
-- want/missing.txt --
genx: producer lazy: zz_x.labels.json: declared in emits, but the producer didn't write it
-- want/nodomain.txt --
genx: producer plain: zz_x.labels.json: no "domain" field (a foreign file needs "domain" in the manifest)
-- want/major.txt --
genx: example.com/app/gen:read needs labels/v1, but a/zz_a.labels.json from producer new says labels/v2; upgrade the module that writes it, or the one that reads it
-- want/slow.txt --
genx: producer slow: timed out after 200ms (raise its timeout in genx.yaml)
