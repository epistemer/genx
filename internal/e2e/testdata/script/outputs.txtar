# What happens to an output when its generator stops writing it, or writes
# it under another case (interface §4, §6, §8).
exec genx
cmp zz_maybe.go want/maybe.go
cmp zz_some.go want/maybe.go
cmp zz_A.go want/maybe.go
grep '^zz_A.go ' genx.lock

# An empty render, and a units query with no output, write no file: the
# files from the earlier run are leftovers, and are deleted.
cp data/off.json cfg.json
cp manifests/off.yaml genx.yaml
exec genx
stdout '^deleted zz_maybe.go$'
stdout '^deleted zz_some.go$'
! exists zz_maybe.go
! exists zz_some.go
! grep 'zz_maybe.go|zz_some.go' genx.lock
exec genx check

# A name that changes only in case: the leftover is deleted before the
# output is written, so this works on a case-insensitive file system too.
cp manifests/lower.yaml genx.yaml
exec genx
stdout '^deleted zz_A.go$'
stdout '^wrote zz_a.go$'
grep '^zz_a.go ' genx.lock
! grep '^zz_A.go ' genx.lock
exec genx check

# A leftover already gone from the disk is dropped from the lock.
rm zz_a.go
cp manifests/none.yaml genx.yaml
exec genx
! stdout 'deleted'
! grep 'zz_a.go' genx.lock

-- genx.yaml --
version: 1
producers:
  - name: cfg
    run: [produce, data/on.json, cfg.json]
    emits:
      - path: cfg.json
        domain: cfg/v1
use:
  - example.com/app/gen: [maybe, some, named]
-- manifests/off.yaml --
version: 1
producers:
  - name: cfg
    run: [produce, data/off.json, cfg.json]
    emits:
      - path: cfg.json
        domain: cfg/v1
use:
  - example.com/app/gen: [maybe, some, named]
-- manifests/lower.yaml --
version: 1
producers:
  - name: cfg
    run: [produce, data/lower.json, cfg.json]
    emits:
      - path: cfg.json
        domain: cfg/v1
use:
  - example.com/app/gen: [named]
-- manifests/none.yaml --
version: 1
producers:
  - name: cfg
    run: [produce, data/lower.json, cfg.json]
    emits:
      - path: cfg.json
        domain: cfg/v1
-- data/on.json --
{"on": true, "name": "A"}
-- data/off.json --
{"on": false, "name": "A"}
-- data/lower.json --
{"on": true, "name": "a"}
-- gen/gen.go --
package gen
-- gen/genx.meta.yaml --
version: 1
generators:
  maybe:
    doc: renders nothing when off
    needs: [cfg/v1]
    units: '.["cfg/v1"][0] | {on}'
    out: '"zz_maybe.go"'
    template: maybe.tmpl
  some:
    doc: has no unit when off
    needs: [cfg/v1]
    units: '.["cfg/v1"][0] | select(.on) | {on}'
    out: '"zz_some.go"'
    template: maybe.tmpl
  named:
    doc: named after the config
    needs: [cfg/v1]
    units: '.["cfg/v1"][0] | {on: true, name}'
    out: '"zz_\(.name).go"'
    template: maybe.tmpl
-- gen/maybe.tmpl --
{{if .on}}// Code generated by test. DO NOT EDIT.

package app
{{end}}
-- want/maybe.go --
// Code generated by test. DO NOT EDIT.

package app
