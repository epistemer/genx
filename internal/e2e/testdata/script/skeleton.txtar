# genx list works before anything has run, when no producer's domain is
# known yet.
exec genx list
cmp stdout want/list-before.txt

# M2.5: a producer writes a labels file; the app's own generator turns it
# into Go.
exec genx
stdout '^settings: wrote internal/settings/zz_settings.labels.json$'
stdout '^wrote internal/settings/zz_settings_consts.go$'
! stderr .
cmp internal/settings/zz_settings_consts.go want/zz_settings_consts.go

# The generated code builds.
exec go build ./...

# A second run writes nothing.
exec genx
! stdout '^wrote '
! stderr .
cmp internal/settings/zz_settings_consts.go want/zz_settings_consts.go

# Now genx list knows the producer's domain from its file.
exec genx list
cmp stdout want/list-after.txt

-- genx.yaml --
version: 1

producers:
  - name: settings
    run: [produce, data/labels.json, internal/settings/zz_settings.labels.json]
    emits:
      - internal/settings/zz_settings.labels.json

use:
  - example.com/app/gen: [consts]
-- gen/gen.go --
package gen
-- gen/genx.meta.yaml --
version: 1

generators:
  consts:
    doc: a constant for every label with a var
    needs: [labels/v1]
    units: |
      .["labels/v1"] | group_by(.package.dir)[]
      | {package: .[0].package, labels: [.[].labels[] | select(.var)]}
    out: '"\(.package.dir)/zz_\(.package.name)_consts.go"'
    template: consts.go.tmpl
-- gen/consts.go.tmpl --
// Code generated by example.com/app/gen. DO NOT EDIT.

package {{.package.name}}

const (
{{- range .labels}}
	{{.var}} = {{printf "%q" .text}}
{{- end}}
)
-- data/labels.json --
{
  "domain": "labels/v1",
  "producer": "test",
  "package": {"name": "settings", "dir": "internal/settings"},
  "labels": [
    {"key": "settings.port", "text": "Listen port", "var": "L10nPort"},
    {"key": "settings.hidden", "text": "Not a constant"},
    {"key": "settings.host", "text": "Listen address", "var": "L10nHost"}
  ]
}
-- internal/settings/doc.go --
package settings
-- want/list-before.txt --
1. producer settings
   runs    produce data/labels.json internal/settings/zz_settings.labels.json
   writes  internal/settings/zz_settings.labels.json (its domain is known once it exists)
2. example.com/app/gen:consts
   doc     a constant for every label with a var
   needs   labels/v1
-- want/list-after.txt --
1. producer settings
   runs    produce data/labels.json internal/settings/zz_settings.labels.json
   writes  internal/settings/zz_settings.labels.json (labels/v1)
2. example.com/app/gen:consts
   doc     a constant for every label with a var
   needs   labels/v1
-- want/zz_settings_consts.go --
// Code generated by example.com/app/gen. DO NOT EDIT.

package settings

const (
	L10nPort = "Listen port"
	L10nHost = "Listen address"
)
