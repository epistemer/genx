# M6.1: replace example.com/labels => ./third_party/labels
# Module files are in third_party/labels; GOPROXY is off.
env GOPROXY=off
exec genx
stdout '^settings: wrote internal/settings/zz_settings.labels.json$'
stdout '^wrote internal/settings/zz_settings_consts.go$'
! stderr .
cmp internal/settings/zz_settings_consts.go want/zz_settings_consts.go

exec go build ./...

-- go.mod --
module example.com/app

go 1.26.0

replace example.com/labels => ./third_party/labels

require example.com/labels v1.0.0
-- tools.go --
//go:build genx

package app

import _ "example.com/labels"
-- app.go --
package app
-- internal/settings/doc.go --
package settings
-- third_party/labels/go.mod --
module example.com/labels

go 1.26.0
-- third_party/labels/labels.go --
package labels
-- third_party/labels/genx.meta.yaml --
version: 1

generators:
  consts:
    doc: a constant for every label with a var
    needs: [labels/v1]
    units: |
      .["labels/v1"] | group_by(.package.dir)[]
      | {package: .[0].package, labels: [.[].labels[] | select(.var)]}
    out: '"\(.package.dir)/zz_\(.package.name)_consts.go"'
    template: consts.go.tmpl
-- third_party/labels/consts.go.tmpl --
// Code generated by example.com/labels. DO NOT EDIT.

package {{.package.name}}

const (
{{- range .labels}}
	{{.var}} = {{printf "%q" .text}}
{{- end}}
)
-- data/labels.json --
{
  "domain": "labels/v1",
  "producer": "test",
  "package": {"name": "settings", "dir": "internal/settings"},
  "labels": [
    {"key": "settings.port", "text": "Listen port", "var": "L10nPort"},
    {"key": "settings.host", "text": "Listen address", "var": "L10nHost"}
  ]
}
-- genx.yaml --
version: 1

producers:
  - name: settings
    run: [produce, data/labels.json, internal/settings/zz_settings.labels.json]
    emits:
      - internal/settings/zz_settings.labels.json

use:
  - example.com/labels: [consts]
-- want/zz_settings_consts.go --
// Code generated by example.com/labels. DO NOT EDIT.

package settings

const (
	L10nPort = "Listen port"
	L10nHost = "Listen address"
)
