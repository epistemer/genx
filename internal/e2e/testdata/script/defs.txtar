# M3.5: defs are shared by every query of a metafile.
exec genx
cmp models/zz_models_names.go want/zz_models_names.go
cmp models/zz_models_types.go want/zz_models_types.go

-- genx.yaml --
version: 1

producers:
  - name: models
    run: [produce, data/request.json, models/request.json]
    emits:
      - path: models/request.json
        domain: sqlc.request/v1

use:
  - example.com/app/gen: [names, types]
-- gen/gen.go --
package gen
-- gen/genx.meta.yaml --
version: 1

defs: |
  def pascal: [splits("[^\\p{L}\\p{N}]+") | select(length > 0)
               | (.[0:1] | ascii_upcase) + .[1:]] | join("");

generators:
  names:
    doc: a constant per enum value
    needs: [sqlc.request/v1]
    units: '.["sqlc.request/v1"][0] | {names: [.enums[] | .name as $t | .vals[] | ($t + "_" + .) | pascal]}'
    out: '"models/zz_models_names.go"'
    template: names.go.tmpl
  types:
    doc: a type per enum
    needs: [sqlc.request/v1]
    units: '.["sqlc.request/v1"][0] | {types: [.enums[].name | pascal]}'
    out: '"models/zz_models_types.go"'
    template: types.go.tmpl
-- gen/names.go.tmpl --
// Code generated by example.com/app/gen. DO NOT EDIT.

package models

const ({{range .names}}
	{{.}} = {{printf "%q" .}}{{end}}
)
-- gen/types.go.tmpl --
// Code generated by example.com/app/gen. DO NOT EDIT.

package models
{{range .types}}
type {{.}} string
{{end}}
-- data/request.json --
{"enums": [{"name": "zp_user_role", "vals": ["admin", "read-only"]}, {"name": "job.status", "vals": ["queued"]}]}
-- want/zz_models_names.go --
// Code generated by example.com/app/gen. DO NOT EDIT.

package models

const (
	ZpUserRoleAdmin    = "ZpUserRoleAdmin"
	ZpUserRoleReadOnly = "ZpUserRoleReadOnly"
	JobStatusQueued    = "JobStatusQueued"
)
-- want/zz_models_types.go --
// Code generated by example.com/app/gen. DO NOT EDIT.

package models

type ZpUserRole string

type JobStatus string
