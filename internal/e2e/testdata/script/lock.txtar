# M5.1: genx.lock lists the files generators wrote, sorted, with the
# generator that wrote each; producers' files aren't in it. Two runs give
# the same lock.
exec genx
cmp genx.lock want/genx.lock
exec genx
cmp genx.lock want/genx.lock

# A run that stopped after writing its files but before the lock: the files
# are what genx would write, so the next run takes them and writes the lock.
rm genx.lock
exec genx
cmp genx.lock want/genx.lock

# A lock genx can't parse stops the run.
cp bad/twice genx.lock
! exec genx
cmp stderr want/twice.txt
cp bad/nostep genx.lock
! exec genx
cmp stderr want/nostep.txt
cp bad/unclean genx.lock
! exec genx
cmp stderr want/unclean.txt

-- genx.yaml --
version: 1
producers:
  - name: labels
    run: [produce, data/labels.json, b/zz_b.labels.json]
    emits: [b/zz_b.labels.json]
use:
  - example.com/app/gen: [consts, copy]
-- gen/gen.go --
package gen
-- gen/genx.meta.yaml --
version: 1
generators:
  consts:
    doc: constants
    needs: [labels/v1]
    units: '.["labels/v1"][] | {package}'
    out: '"\(.package.dir)/zz_\(.package.name)_consts.go"'
    template: consts.tmpl
  copy:
    doc: a copy of the labels in another package
    needs: [labels/v1]
    emits: labels/v1
    units: '.["labels/v1"][0] | .package = {name: "a", dir: "a"}'
    out: '"a/zz_a.copy.json"'
-- gen/consts.tmpl --
// Code generated by test. DO NOT EDIT.

package {{.package.name}}
-- data/labels.json --
{"domain": "labels/v1", "producer": "p", "package": {"name": "b", "dir": "b"}, "labels": []}
-- bad/twice --
a/zz_a_consts.go example.com/app/gen:consts
a/zz_A_consts.go example.com/app/gen:consts
-- bad/nostep --
a/zz_a_consts.go consts
-- bad/unclean --
./a/zz_a_consts.go example.com/app/gen:consts
-- want/twice.txt --
genx: genx.lock:2: a/zz_A_consts.go is listed twice
genx.lock is generated: restore it from version control, or delete it and run genx
-- want/nostep.txt --
genx: genx.lock:1: want "<path> <package>:<generator>", got "a/zz_a_consts.go consts"
genx.lock is generated: restore it from version control, or delete it and run genx
-- want/unclean.txt --
genx: genx.lock:1: "./a/zz_a_consts.go" isn't clean (use "a/zz_a_consts.go")
genx.lock is generated: restore it from version control, or delete it and run genx
-- want/genx.lock --
# Code generated by genx. DO NOT EDIT.
# The files genx wrote, and the generator that wrote each.
a/zz_a.copy.json example.com/app/gen:copy
a/zz_a_consts.go example.com/app/gen:consts
b/zz_b_consts.go example.com/app/gen:consts
