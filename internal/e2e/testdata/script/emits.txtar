# M3.3, M4.1, M4.3: a foreign file named in the manifest becomes a domain
# through a generator that emits labels/v1, which a second generator turns
# into Go. The use entries are in the wrong order on purpose: the plan orders
# them by the domains they need and write.
exec genx
cmp models/zz_enums.labels.json want/zz_enums.labels.json
cmp models/zz_models_consts.go want/zz_models_consts.go
exec go build ./...

exec genx
! stdout '^wrote '

# genx list shows the same order.
exec genx list
cmp stdout want/list.txt

-- genx.yaml --
version: 1

producers:
  - name: models
    run: [produce, data/request.json, models/request.json]
    emits:
      - path: models/request.json
        domain: sqlc.request/v1

use:
  - example.com/app/gen: [consts, enum-labels]
-- gen/gen.go --
package gen
-- gen/genx.meta.yaml --
version: 1

generators:
  enum-labels:
    doc: a labels file for the enums in sqlc's request
    needs: [sqlc.request/v1]
    emits: labels/v1
    units: |
      .["sqlc.request/v1"][0]
      | {domain: "labels/v1", producer: "models",
         package: {name: "models", dir: "models"},
         labels: [.enums[] | .name as $t | .vals[]
                  | {key: "enum.\($t).\(.)", text: ., var: "L10n\(.)"}]}
    out: '"models/zz_enums.labels.json"'
  consts:
    doc: a constant for every label with a var
    needs: [labels/v1]
    units: |
      .["labels/v1"] | group_by(.package.dir)[]
      | {package: .[0].package, labels: [.[].labels[] | select(.var)]}
    out: '"\(.package.dir)/zz_\(.package.name)_consts.go"'
    template: consts.go.tmpl
-- gen/consts.go.tmpl --
// Code generated by example.com/app/gen. DO NOT EDIT.

package {{.package.name}}

const (
{{- range .labels}}
	{{.var}} = {{printf "%q" .text}}
{{- end}}
)
-- models/doc.go --
package models
-- data/request.json --
{"enums": [{"name": "role", "vals": ["Admin", "Guest"]}]}
-- want/zz_enums.labels.json --
{
  "domain": "labels/v1",
  "labels": [
    {
      "key": "enum.role.Admin",
      "text": "Admin",
      "var": "L10nAdmin"
    },
    {
      "key": "enum.role.Guest",
      "text": "Guest",
      "var": "L10nGuest"
    }
  ],
  "package": {
    "dir": "models",
    "name": "models"
  },
  "producer": "models"
}
-- want/zz_models_consts.go --
// Code generated by example.com/app/gen. DO NOT EDIT.

package models

const (
	L10nAdmin = "Admin"
	L10nGuest = "Guest"
)
-- want/list.txt --
1. producer models
   runs    produce data/request.json models/request.json
   writes  models/request.json (sqlc.request/v1, foreign)
2. example.com/app/gen:enum-labels
   doc     a labels file for the enums in sqlc's request
   needs   sqlc.request/v1
   emits   labels/v1
3. example.com/app/gen:consts
   doc     a constant for every label with a var
   needs   labels/v1
