# M6.1: module cache. Require example.com/labels v1.0.0, download it,
# run genx list (shows unused generator and bad metafile warning), run genx,
# cmp generated output, build.
exec go mod download
exec go mod tidy

# List before switching on example.com/labels:consts.
cp genx-unused.yaml genx.yaml
exec genx list
cmp stdout want/list-unused.txt

# Now switch on example.com/labels:consts.
cp genx-used.yaml genx.yaml
exec genx
stdout '^settings: wrote internal/settings/zz_settings.labels.json$'
stdout '^wrote internal/settings/zz_settings_consts.go$'
! stderr .
cmp internal/settings/zz_settings_consts.go want/zz_settings_consts.go

# The generated code builds.
exec go build ./...

# List after switching on: only local unused generator and bad metafile remain.
exec genx list
cmp stdout want/list-used.txt

-- go.mod --
module example.com/app

go 1.26.0

require example.com/labels v1.0.0
-- tools.go --
//go:build genx

package app

import _ "example.com/labels"
-- app.go --
package app
-- internal/settings/doc.go --
package settings
-- gen/gen.go --
package gen
-- gen/genx.meta.yaml --
version: 1

generators:
  other:
    doc: a local generator not switched on
    needs: [labels/v1]
    units: '{}'
    out: '"zz_other.go"'
    template: other.tmpl
-- gen/other.tmpl --
// Code generated by test. DO NOT EDIT.

package gen
-- bad/bad.go --
package bad
-- bad/genx.meta.yaml --
version: 99
-- data/labels.json --
{
  "domain": "labels/v1",
  "producer": "test",
  "package": {"name": "settings", "dir": "internal/settings"},
  "labels": [
    {"key": "settings.port", "text": "Listen port", "var": "L10nPort"},
    {"key": "settings.host", "text": "Listen address", "var": "L10nHost"}
  ]
}
-- genx-unused.yaml --
version: 1

producers:
  - name: settings
    run: [produce, data/labels.json, internal/settings/zz_settings.labels.json]
    emits:
      - internal/settings/zz_settings.labels.json
-- genx-used.yaml --
version: 1

producers:
  - name: settings
    run: [produce, data/labels.json, internal/settings/zz_settings.labels.json]
    emits:
      - internal/settings/zz_settings.labels.json

use:
  - example.com/labels: [consts]
-- want/list-unused.txt --
1. producer settings
   runs    produce data/labels.json internal/settings/zz_settings.labels.json
   writes  internal/settings/zz_settings.labels.json (its domain is known once it exists)

Not switched on:
  warning: example.com/app/bad/genx.meta.yaml: 1: generators: required
  example.com/app/gen:other
      a local generator not switched on
  example.com/labels:consts (example.com/labels v1.0.0)
      a constant for every label with a var
-- want/list-used.txt --
1. producer settings
   runs    produce data/labels.json internal/settings/zz_settings.labels.json
   writes  internal/settings/zz_settings.labels.json (labels/v1)
2. example.com/labels:consts
   doc     a constant for every label with a var
   needs   labels/v1

Not switched on:
  warning: example.com/app/bad/genx.meta.yaml: 1: generators: required
  example.com/app/gen:other
      a local generator not switched on
-- want/zz_settings_consts.go --
// Code generated by example.com/labels. DO NOT EDIT.

package settings

const (
	L10nPort = "Listen port"
	L10nHost = "Listen address"
)
