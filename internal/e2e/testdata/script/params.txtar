# Interface amendment A4: a metafile declares parameters, an app sets them in
# the map form of its use entry, and every query reads them as $params. The
# shape is the models package's (models ADR 0001, D2): dir, package (null
# means the last element of dir) and table_prefix.

# The app sets dir and table_prefix; package keeps its default, null.
exec genx
stdout '^wrote db/zz_db.labels.json$'
stdout '^wrote db/zz_db_consts.go$'
! stderr .
cmp db/zz_db.labels.json want/zz_db.labels.json
cmp db/zz_db_consts.go want/zz_db_consts.go
exec go build ./db

# genx list shows each parameter's value and marks the defaults.
exec genx list
cmp stdout want/list.txt

# Determinism: a second run writes nothing.
exec genx
! stdout '^wrote '
! stderr .

# The list form uses every default: dir models, prefix "".
cp genx-list-form.yaml genx.yaml
exec genx
stdout '^wrote models/zz_models.labels.json$'
stdout '^wrote models/zz_models_consts.go$'
cmp models/zz_models_consts.go want/zz_models_consts.go
! exists db/zz_db_consts.go
exec genx list
stdout '^   param   dir = "models" \(default\)$'
stdout '^   param   package = null \(default\)$'
stdout '^   param   table_prefix = "" \(default\)$'

# A null default accepts any type; a value of the default's type is fine.
cp genx-package.yaml genx.yaml
exec genx
stdout '^wrote db/zz_store.labels.json$'
stdout '^wrote db/zz_store_consts.go$'
grep '^package store$' db/zz_store_consts.go
exec genx list
stdout '^   param   package = "store"$'

# genx check sees parameters as genx does: it passes now, and fails when a
# parameter changes what the generators would write.
exec genx check
cp genx-list-form.yaml genx.yaml
! exec genx check
stderr '^  missing   models/zz_models_consts.go \(example.com/app/gen:consts\)$'
stderr '^  leftover  db/zz_store_consts.go \(example.com/app/gen:consts wrote it; nothing does now\)$'

-- genx.yaml --
version: 1

producers:
  - name: models
    run: [produce, data/request.json, data/zz_request.json]
    emits:
      - path: data/zz_request.json
        domain: sqlc.request/v1

use:
  - example.com/app/gen:
      generators: [labels, consts]
      params:
        dir: db
        table_prefix: app_
-- genx-list-form.yaml --
version: 1

producers:
  - name: models
    run: [produce, data/request.json, data/zz_request.json]
    emits:
      - path: data/zz_request.json
        domain: sqlc.request/v1

use:
  - example.com/app/gen: [labels, consts]
-- genx-package.yaml --
version: 1

producers:
  - name: models
    run: [produce, data/request.json, data/zz_request.json]
    emits:
      - path: data/zz_request.json
        domain: sqlc.request/v1

use:
  - example.com/app/gen:
      generators: [labels, consts]
      params: {dir: db, package: store, table_prefix: app_}
-- gen/gen.go --
package gen
-- gen/genx.meta.yaml --
version: 1

params:
  dir:
    doc: the directory of the models package, from the module root
    default: models
  package:
    doc: the models package's name; null means the last element of dir
    default: null
  table_prefix:
    doc: a prefix that table names carry and labels leave out
    default: ""

defs: |
  # In defs as in units and out: $params holds every parameter.
  def pkg: $params.package // ($params.dir | split("/") | last);
  def strip: ($params.table_prefix) as $p
    | if ($p != "" and startswith($p)) then .[($p | length):] else . end;
  def pascal: [splits("_") | select(length > 0) | (.[0:1] | ascii_upcase) + .[1:]] | join("");

generators:
  labels:
    doc: a label for every table
    needs: [sqlc.request/v1]
    emits: labels/v1
    units: |
      .["sqlc.request/v1"][0]
      | {domain: "labels/v1", producer: "models",
         package: {name: pkg, dir: $params.dir},
         labels: [.tables[] | {key: "table.\(.)", text: (strip | pascal),
                               var: "L10n\(strip | pascal)"}]}
    out: '"\($params.dir)/zz_\(pkg).labels.json"'
  consts:
    doc: a constant per label with a var
    needs: [labels/v1]
    units: '.["labels/v1"][] | {package: .package, labels: [.labels[] | select(.var)]}'
    out: '"\(.package.dir)/zz_\(.package.name)_consts.go"'
    template: consts.go.tmpl
-- gen/consts.go.tmpl --
// Code generated by example.com/app/gen. DO NOT EDIT.

package {{.package.name}}

const ({{range .labels}}
	{{.var}} = {{printf "%q" .key}}{{end}}
)
-- data/request.json --
{"tables": ["app_user", "app_job_run"]}
-- want/zz_db.labels.json --
{
  "domain": "labels/v1",
  "labels": [
    {
      "key": "table.app_user",
      "text": "User",
      "var": "L10nUser"
    },
    {
      "key": "table.app_job_run",
      "text": "JobRun",
      "var": "L10nJobRun"
    }
  ],
  "package": {
    "dir": "db",
    "name": "db"
  },
  "producer": "models"
}
-- want/zz_db_consts.go --
// Code generated by example.com/app/gen. DO NOT EDIT.

package db

const (
	L10nUser   = "table.app_user"
	L10nJobRun = "table.app_job_run"
)
-- want/zz_models_consts.go --
// Code generated by example.com/app/gen. DO NOT EDIT.

package models

const (
	L10nAppUser   = "table.app_user"
	L10nAppJobRun = "table.app_job_run"
)
-- want/list.txt --
1. producer models
   runs    produce data/request.json data/zz_request.json
   writes  data/zz_request.json (sqlc.request/v1, foreign)
2. example.com/app/gen:labels
   doc     a label for every table
   needs   sqlc.request/v1
   emits   labels/v1
   param   dir = "db"
   param   package = null (default)
   param   table_prefix = "app_"
3. example.com/app/gen:consts
   doc     a constant per label with a var
   needs   labels/v1
   param   dir = "db"
   param   package = null (default)
   param   table_prefix = "app_"
