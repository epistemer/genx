# M3.4: when a generator fails, the message names it, its package and its
# input files, or the template's file and line, or the generated lines.

# A query's error().
cp manifests/clash.yaml genx.yaml
! exec genx
cmp stderr want/clash.txt

# A key the template reads is missing from the unit.
cp manifests/missing.yaml genx.yaml
! exec genx
cmp stderr want/missing.txt

# The template makes Go that doesn't parse.
cp manifests/badgo.yaml genx.yaml
! exec genx
cmp stderr want/badgo.txt

# A Go file without the generated-code header.
cp manifests/noheader.yaml genx.yaml
! exec genx
cmp stderr want/noheader.txt

# A refused function, when the metafile is read.
cp manifests/clock.yaml genx.yaml
! exec genx
cmp stderr want/clock.txt

# A unit of a generator that emits a domain must be an object...
cp manifests/unitarray.yaml genx.yaml
! exec genx
cmp stderr want/unitarray.txt

# ...that names the domain the generator emits...
cp manifests/wrongdomain.yaml genx.yaml
! exec genx
cmp stderr want/wrongdomain.txt

# ...and passes that domain's checks.
cp manifests/badlabels.yaml genx.yaml
! exec genx
cmp stderr want/badlabels.txt

# Nothing was written.
! exists zz_out.go
! exists zz_x.labels.json

-- gen/gen.go --
package gen
-- gen/genx.meta.yaml --
version: 1

generators:
  clash:
    doc: one key, two texts
    needs: [labels/v1]
    units: |
      .["labels/v1"] | [.[].labels[]] | group_by(.key)[]
      | select(map(.text) | unique | length > 1)
      | error("one key, two texts: \(.[0].key)")
    out: '"zz_out.go"'
    template: ok.tmpl
  missing:
    doc: reads a key the unit lacks
    needs: [labels/v1]
    units: '{name: "x"}'
    out: '"zz_out.go"'
    template: missing.tmpl
  badgo:
    doc: broken Go
    needs: [labels/v1]
    units: '{}'
    out: '"zz_out.go"'
    template: badgo.tmpl
  noheader:
    doc: no header
    needs: [labels/v1]
    units: '{}'
    out: '"zz_out.go"'
    template: noheader.tmpl
  clock:
    doc: reads the clock
    needs: [labels/v1]
    units: '{t: now}'
    out: '"zz_out.go"'
    template: ok.tmpl
  unitarray:
    doc: emits an array
    needs: [labels/v1]
    emits: labels/v1
    units: '[1]'
    out: '"zz_x.labels.json"'
  wrongdomain:
    doc: emits another domain
    needs: [labels/v1]
    emits: labels/v1
    units: '{domain: "other/v1"}'
    out: '"zz_x.labels.json"'
  badlabels:
    doc: emits a labels file without a package
    needs: [labels/v1]
    emits: labels/v1
    units: '{domain: "labels/v1", producer: "x", labels: []}'
    out: '"zz_x.labels.json"'
-- gen/ok.tmpl --
// Code generated by test. DO NOT EDIT.

package app
-- gen/missing.tmpl --
// Code generated by test. DO NOT EDIT.

package app

// {{.name}} is {{.kind}}.
-- gen/badgo.tmpl --
// Code generated by test. DO NOT EDIT.

package app

func one() int {
	return 1
}

func two() int {
	return 2 +
}

func three() int {
	return 3
}
-- gen/noheader.tmpl --
package app
-- data/a.json --
{"domain": "labels/v1", "producer": "a", "package": {"name": "a", "dir": "a"},
 "labels": [{"key": "title", "text": "Title"}]}
-- data/b.json --
{"domain": "labels/v1", "producer": "b", "package": {"name": "b", "dir": "b"},
 "labels": [{"key": "title", "text": "Heading"}]}
-- manifests/clash.yaml --
version: 1
producers:
  - name: a
    run: [produce, data/a.json, a/zz_a.labels.json]
    emits: [a/zz_a.labels.json]
  - name: b
    run: [produce, data/b.json, b/zz_b.labels.json]
    emits: [b/zz_b.labels.json]
use:
  - example.com/app/gen: [clash]
-- manifests/missing.yaml --
version: 1
producers:
  - name: a
    run: [produce, data/a.json, a/zz_a.labels.json]
    emits: [a/zz_a.labels.json]
use:
  - example.com/app/gen: [missing]
-- manifests/badgo.yaml --
version: 1
producers:
  - name: a
    run: [produce, data/a.json, a/zz_a.labels.json]
    emits: [a/zz_a.labels.json]
use:
  - example.com/app/gen: [badgo]
-- manifests/noheader.yaml --
version: 1
producers:
  - name: a
    run: [produce, data/a.json, a/zz_a.labels.json]
    emits: [a/zz_a.labels.json]
use:
  - example.com/app/gen: [noheader]
-- manifests/clock.yaml --
version: 1
producers:
  - name: a
    run: [produce, data/a.json, a/zz_a.labels.json]
    emits: [a/zz_a.labels.json]
use:
  - example.com/app/gen: [clock]
-- manifests/unitarray.yaml --
version: 1
producers:
  - name: a
    run: [produce, data/a.json, a/zz_a.labels.json]
    emits: [a/zz_a.labels.json]
use:
  - example.com/app/gen: [unitarray]
-- manifests/wrongdomain.yaml --
version: 1
producers:
  - name: a
    run: [produce, data/a.json, a/zz_a.labels.json]
    emits: [a/zz_a.labels.json]
use:
  - example.com/app/gen: [wrongdomain]
-- manifests/badlabels.yaml --
version: 1
producers:
  - name: a
    run: [produce, data/a.json, a/zz_a.labels.json]
    emits: [a/zz_a.labels.json]
use:
  - example.com/app/gen: [badlabels]
-- want/unitarray.txt --
genx: example.com/app/gen:unitarray: a unit for zz_x.labels.json: not an object, so it can't name its domain (each unit must be an object with "domain": "labels/v1")
-- want/wrongdomain.txt --
genx: example.com/app/gen:wrongdomain: a unit for zz_x.labels.json says domain other/v1; the generator emits labels/v1
-- want/badlabels.txt --
genx: example.com/app/gen:badlabels: zz_x.labels.json: package: required
-- want/clash.txt --
genx: example.com/app/gen:clash: units: one key, two texts: title
(input: a/zz_a.labels.json, b/zz_b.labels.json)
-- want/missing.txt --
genx: example.com/app/gen:missing: template: missing.tmpl:5:18: executing "missing.tmpl" at <.kind>: map has no entry for key "kind"
-- want/badgo.txt --
genx: example.com/app/gen:badgo: zz_out.go: 11:1: expected operand, found '}' (and 1 more errors)
   8: 
   9: func two() int {
  10: 	return 2 +
  11: }
  12: 
  13: func three() int {
  14: 	return 3
-- want/noheader.txt --
genx: example.com/app/gen:noheader: zz_out.go: a generated Go file must start with "// Code generated ... DO NOT EDIT."
-- want/clock.txt --
genx: example.com/app/gen/genx.meta.yaml:34: units: "now" is not allowed in a query (it reads the clock)
