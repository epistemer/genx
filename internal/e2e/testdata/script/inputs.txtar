# M3.1: a generator's input is an object keyed by domain, each holding the
# domain's files in path order, whatever order the producers ran in. JSON and
# YAML both work.
exec genx
cmp zz_inputs.go want/zz_inputs.go

# Twice gives the same bytes.
exec genx
! stdout '^wrote '
cmp zz_inputs.go want/zz_inputs.go

-- genx.yaml --
version: 1

producers:
  - name: second
    run: [produce, data/b.json, b/zz_b.labels.json]
    emits: [b/zz_b.labels.json]
  - name: first
    run: [produce, data/a.json, a/zz_a.labels.json]
    emits: [a/zz_a.labels.json]
  - name: config
    run: [produce, data/config.yaml, config.yaml]
    emits:
      - path: config.yaml
        domain: app.config/v1

use:
  - example.com/app/gen: [inputs]
-- gen/gen.go --
package gen
-- gen/genx.meta.yaml --
version: 1

generators:
  inputs:
    doc: what the input looks like
    needs: [labels/v1, app.config/v1]
    units: '{domains: keys, producers: [.["labels/v1"][].producer], config: .["app.config/v1"][0]}'
    out: '"zz_inputs.go"'
    template: inputs.go.tmpl
-- gen/inputs.go.tmpl --
// Code generated by example.com/app/gen. DO NOT EDIT.

package app

// Domains: {{range .domains}}{{.}} {{end}}
// Producers in path order: {{range .producers}}{{.}} {{end}}
// Config: {{.config.name}}, port {{.config.port}}, big {{.config.big}}
-- data/a.json --
{"domain": "labels/v1", "producer": "first", "package": {"name": "a", "dir": "a"}, "labels": []}
-- data/b.json --
{"domain": "labels/v1", "producer": "second", "package": {"name": "b", "dir": "b"}, "labels": []}
-- data/config.yaml --
name: demo
port: 8080
big: 12345678901234567890
-- want/zz_inputs.go --
// Code generated by example.com/app/gen. DO NOT EDIT.

package app

// Domains: app.config/v1 labels/v1
// Producers in path order: first second
// Config: demo, port 8080, big 12345678901234567890
