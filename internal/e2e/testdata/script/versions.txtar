# M6.4: a metafile with version: 2 is rejected with an upgrade genx message.
! exec genx
cmp stderr want/stderr.txt

-- genx.yaml --
version: 1

use:
  - example.com/app/gen: [consts]
-- gen/gen.go --
package gen
-- gen/genx.meta.yaml --
version: 2

generators:
  consts:
    doc: a generator
    needs: [labels/v1]
    units: '{}'
    out: '"zz_out.go"'
    template: out.tmpl
-- gen/out.tmpl --
// Code generated by test. DO NOT EDIT.

package gen
-- want/stderr.txt --
genx: example.com/app/gen/genx.meta.yaml:1: version: version 2 is newer than this genx supports; upgrade genx
