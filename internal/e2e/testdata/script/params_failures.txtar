# Interface amendment A4: what genx refuses in parameters, each with the file
# and line.

# A parameter the package doesn't declare, and a value whose JSON type
# differs from a non-null default's, are both reported at once.
! exec genx
stderr 'genx.yaml:7: use\[0\].example.com/app/gen.params.colour: example.com/app/gen declares no parameter "colour" \(it declares: dir, package, table_prefix\)$'
stderr 'genx.yaml:8: use\[0\].example.com/app/gen.params.dir: must be a string, as its default "models" is \(got a number\)$'
stderr 'genx.yaml:9: use\[0\].example.com/app/gen.params.table_prefix: must be a string, as its default "" is \(got null\)$'
! exists zz_a.go
! exists genx.lock

# genx check and genx list refuse the same.
! exec genx check
stderr 'declares no parameter "colour"'
! exec genx list
stderr 'declares no parameter "colour"'

# A package that declares no parameters.
cp genx-none.yaml genx.yaml
! exec genx
stderr 'genx.yaml:6: use\[0\].example.com/app/plain.params.dir: example.com/app/plain declares no parameter "dir" \(it declares none\)$'

# The map form's shape.
cp genx-shape.yaml genx.yaml
! exec genx
stderr 'genx.yaml:4: use\[0\].example.com/app/gen.generators: required$'
stderr 'genx.yaml:6: use\[1\].example.com/app/gen.param: unknown field$'
stderr 'genx.yaml:8: use\[2\].example.com/app/gen.params: must be a mapping of parameter names to values$'
stderr 'genx.yaml:10: use\[3\].example.com/app/gen: must be a sequence of generator names, or a mapping \{generators, params\}$'

# The metafile's declarations.
cp genx-bad.yaml genx.yaml
! exec genx
stderr 'example.com/app/bad/genx.meta.yaml:4: params.Dir: "Dir" is not a valid parameter name \(a lowercase letter, then lowercase letters, digits and _\)$'
stderr 'example.com/app/bad/genx.meta.yaml:6: params.nodoc.doc: required$'
stderr 'example.com/app/bad/genx.meta.yaml:8: params.nodefault.default: required \(write default: null for a parameter with no default value\)$'
stderr 'example.com/app/bad/genx.meta.yaml:12: params.extra.kind: unknown field$'
stderr 'example.com/app/bad/genx.meta.yaml:14: params.flat: must be a mapping \{doc, default\}$'

-- genx.yaml --
version: 1

use:
  - example.com/app/gen:
      generators: [a]
      params:
        colour: blue
        dir: 7
        table_prefix: null
-- genx-none.yaml --
version: 1

use:
  - example.com/app/plain:
      generators: [a]
      params: {dir: db}
-- genx-shape.yaml --
version: 1

use:
  - example.com/app/gen: {params: {dir: db}}
  - example.com/app/gen:
      param: {dir: db}
      generators: [a]
  - example.com/app/gen: {generators: [b], params: [dir]}
  - example.com/app/gen:
      a
-- genx-bad.yaml --
version: 1

use:
  - example.com/app/bad: [a]
-- gen/gen.go --
package gen
-- gen/genx.meta.yaml --
version: 1

params:
  dir: {doc: the models directory, default: models}
  package: {doc: the package name, default: null}
  table_prefix: {doc: a prefix to strip, default: ""}

generators:
  a:
    doc: a file
    needs: [x/v1]
    units: '{}'
    out: '"zz_a.go"'
    template: a.tmpl
  b:
    doc: another file
    needs: [x/v1]
    units: '{}'
    out: '"zz_b.go"'
    template: a.tmpl
-- gen/a.tmpl --
// Code generated by example.com/app/gen. DO NOT EDIT.

package app
-- plain/plain.go --
package plain
-- plain/genx.meta.yaml --
version: 1

generators:
  a:
    doc: a file
    needs: [x/v1]
    units: '{}'
    out: '"zz_a.go"'
    template: a.tmpl
-- plain/a.tmpl --
// Code generated by example.com/app/plain. DO NOT EDIT.

package app
-- bad/bad.go --
package bad
-- bad/genx.meta.yaml --
version: 1

params:
  Dir: {doc: a directory, default: models}
  ok: {doc: fine, default: 1}
  nodoc:
    default: 1
  nodefault:
    doc: no default
  extra:
    doc: an extra field
    kind: string
    default: 1
  flat: models

generators:
  a:
    doc: a file
    needs: [x/v1]
    units: '{}'
    out: '"zz_a.go"'
    template: a.tmpl
-- bad/a.tmpl --
// Code generated by example.com/app/bad. DO NOT EDIT.

package app
