# How genx orders steps, when it can't.

# Two producers that need each other's domains.
cp manifests/cycle.yaml genx.yaml
! exec genx
cmp stderr want/cycle.txt

# A step that needs no domain no step writes.
cp manifests/unwritten.yaml genx.yaml
! exec genx
cmp stderr want/unwritten.txt

# On a first run, a producer with needs writes a domain a generator already
# read. The second run knows the domain from the file and gets it right.
cp manifests/late.yaml genx.yaml
! exec genx
cmp stderr want/late.txt
exec genx
exists zz_seen.go
exec genx check

-- gen/gen.go --
package gen
-- gen/genx.meta.yaml --
version: 1
generators:
  seen:
    doc: lists the labels producers
    needs: [labels/v1]
    units: '{producers: [.["labels/v1"][].producer]}'
    out: '"zz_seen.go"'
    template: seen.tmpl
  config-x:
    doc: turns the config into x/v1
    needs: [app.config/v1]
    emits: x/v1
    units: '{domain: "x/v1"}'
    out: '"zz_config.x.json"'
-- gen/seen.tmpl --
// Code generated by test. DO NOT EDIT.

package app

// Producers: {{range .producers}}{{.}} {{end}}
-- data/labels.json --
{"domain": "labels/v1", "producer": "late", "package": {"name": "app", "dir": "."}, "labels": []}
-- data/config.json --
{"domain": "app.config/v1"}
-- manifests/cycle.yaml --
version: 1
producers:
  - name: a
    run: [consume, zz_b.json, zz_a.json]
    needs: [b/v1]
    emits:
      - path: zz_a.json
        domain: a/v1
  - name: b
    run: [consume, zz_a.json, zz_b.json]
    needs: [a/v1]
    emits:
      - path: zz_b.json
        domain: b/v1
-- manifests/unwritten.yaml --
version: 1
use:
  - example.com/app/gen: [seen]
-- manifests/late.yaml --
version: 1
producers:
  - name: late
    run: [produce, data/labels.json, zz_app.labels.json]
    needs: [x/v1]
    emits: [zz_app.labels.json]
  - name: config
    run: [produce, data/config.json, zz_config.json]
    emits:
      - path: zz_config.json
        domain: app.config/v1
use:
  - example.com/app/gen: [seen, config-x]
-- want/cycle.txt --
genx: these steps need each other's domains: producer a (needs b/v1, written by producer b); producer b (needs a/v1, written by producer a)
-- want/unwritten.txt --
genx: example.com/app/gen:seen needs labels/v1, which no step writes; add what writes it to genx.yaml, or remove what needs it
-- want/late.txt --
genx: example.com/app/gen:seen needed labels/v1, but ran before producer late, which writes it; run genx again: the second run reads the domain from the file
