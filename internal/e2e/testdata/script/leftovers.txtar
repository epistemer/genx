# M5.2: output nothing produces any more is deleted when it still looks
# generated; anything that may hold edits stops the run, untouched.
exec genx
exists zz_one.go
exists zz_two.go
exists zz_data.json

# Switching a generator off deletes its file, and the lock drops it.
cp manifests/one.yaml genx.yaml
exec genx
stdout '^deleted zz_two.go$'
! exists zz_two.go
! grep zz_two.go genx.lock

# A leftover Go file whose header is gone is kept, and the run stops.
cp manifests/both.yaml genx.yaml
exec genx
cp manifests/one.yaml genx.yaml
cp edited.go zz_two.go
! exec genx
cmp stderr want/edited-leftover.txt
exists zz_two.go

# A leftover that isn't Go is deleted by being in the lock.
cp manifests/both.yaml genx.yaml
rm zz_two.go
exec genx
cp manifests/nodata.yaml genx.yaml
exec genx
stdout '^deleted zz_data.json$'
! exists zz_data.json

# Never replace a file genx didn't write.
cp manifests/both.yaml genx.yaml
rm genx.lock
! exec genx
cmp stderr want/not-ours.txt

# An output in the lock that lost its header isn't overwritten either.
exec genx list
cp want/lock genx.lock
cp edited.go zz_one.go
! exec genx
cmp stderr want/edited-output.txt
cmp zz_one.go edited.go

-- genx.yaml --
version: 1
producers:
  - name: cfg
    run: [produce, data/cfg.json, cfg.json]
    emits:
      - path: cfg.json
        domain: cfg/v1
use:
  - example.com/app/gen: [one, two, data]
-- manifests/one.yaml --
version: 1
producers:
  - name: cfg
    run: [produce, data/cfg.json, cfg.json]
    emits:
      - path: cfg.json
        domain: cfg/v1
use:
  - example.com/app/gen: [one, data]
-- manifests/both.yaml --
version: 1
producers:
  - name: cfg
    run: [produce, data/cfg.json, cfg.json]
    emits:
      - path: cfg.json
        domain: cfg/v1
use:
  - example.com/app/gen: [one, two, data]
-- manifests/nodata.yaml --
version: 1
producers:
  - name: cfg
    run: [produce, data/cfg.json, cfg.json]
    emits:
      - path: cfg.json
        domain: cfg/v1
use:
  - example.com/app/gen: [one, two]
-- gen/gen.go --
package gen
-- gen/genx.meta.yaml --
version: 1
generators:
  one:
    doc: one
    needs: [cfg/v1]
    units: '{}'
    out: '"zz_one.go"'
    template: x.tmpl
  two:
    doc: two
    needs: [cfg/v1]
    units: '{}'
    out: '"zz_two.go"'
    template: x.tmpl
  data:
    doc: data
    needs: [cfg/v1]
    emits: data/v1
    units: '{domain: "data/v1"}'
    out: '"zz_data.json"'
-- gen/x.tmpl --
// Code generated by test. DO NOT EDIT.

package app
-- data/cfg.json --
{}
-- edited.go --
package app

// Someone's edit.
-- want/lock --
# Code generated by genx. DO NOT EDIT.
# The files genx wrote, and the generator that wrote each.
zz_data.json example.com/app/gen:data
zz_one.go example.com/app/gen:one
zz_two.go example.com/app/gen:two
-- want/edited-leftover.txt --
genx: zz_two.go, which example.com/app/gen:two wrote, is no longer generated, but it has lost its generated-code header, so it may hold edits; delete it or move it, then run genx again
-- want/not-ours.txt --
genx: example.com/app/gen:one: zz_one.go exists and isn't in genx.lock, so genx didn't write it; move it away, then run genx again
example.com/app/gen:two: zz_two.go exists and isn't in genx.lock, so genx didn't write it; move it away, then run genx again
-- want/edited-output.txt --
genx: example.com/app/gen:one: zz_one.go has lost its generated-code header, so it may hold edits; restore the header or delete the file, then run genx again
