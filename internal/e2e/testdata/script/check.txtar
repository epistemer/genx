# M5.3: genx check writes nothing, and fails on every kind of staleness,
# listing each file.
exec genx
exec genx check
cmp stdout want/trusted.txt
! stderr .

# A hand edit makes an output stale.
cp edited.go zz_one.go
treehash
cp stdout treehash-before
! exec genx check
cmp stderr want/stale.txt
treehash
cmp stdout treehash-before
exec genx

# A deleted output is missing.
rm zz_one.go
! exec genx check
cmp stderr want/missing.txt
exec genx

# A file in the lock that nothing produces is leftover; the lock is stale too.
cp want/extra-lock genx.lock
cp edited.go zz_old.go
! exec genx check
cmp stderr want/leftover.txt
rm zz_old.go
exec genx

# A producer's input changed: its check command fails, and its output is
# still read for the generators after it.
cp manifests/checked.yaml genx.yaml
exec genx
exec genx check
! stdout 'not checked'
cp manifests/failing.yaml genx.yaml
! exec genx check
cmp stderr want/producer.txt

-- genx.yaml --
version: 1
producers:
  - name: cfg
    run: [produce, data/cfg.json, cfg.json]
    emits:
      - path: cfg.json
        domain: cfg/v1
use:
  - example.com/app/gen: [one, two]
-- manifests/checked.yaml --
version: 1
producers:
  - name: cfg
    run: [produce, data/cfg.json, cfg.json]
    check: [produce, data/cfg.json, data/cfg.json]
    emits:
      - path: cfg.json
        domain: cfg/v1
use:
  - example.com/app/gen: [one, two]
-- manifests/failing.yaml --
version: 1
producers:
  - name: cfg
    run: [produce, data/cfg.json, cfg.json]
    check: [fail, cfg.json is stale]
    emits:
      - path: cfg.json
        domain: cfg/v1
use:
  - example.com/app/gen: [one, two]
-- gen/gen.go --
package gen
-- gen/genx.meta.yaml --
version: 1
generators:
  one:
    doc: one
    needs: [cfg/v1]
    units: '{}'
    out: '"zz_one.go"'
    template: x.tmpl
  two:
    doc: two
    needs: [cfg/v1]
    units: '{}'
    out: '"zz_two.go"'
    template: x.tmpl
-- gen/x.tmpl --
// Code generated by test. DO NOT EDIT.

package app
-- data/cfg.json --
{}
-- edited.go --
// Code generated by test. DO NOT EDIT.

package app

// An edit.
-- want/extra-lock --
# Code generated by genx. DO NOT EDIT.
# The files genx wrote, and the generator that wrote each.
zz_old.go example.com/app/gen:old
zz_one.go example.com/app/gen:one
zz_two.go example.com/app/gen:two
-- want/trusted.txt --
cfg: not checked (no check command)
-- want/stale.txt --
genx: check found 1 problem; run genx:
  stale     zz_one.go (example.com/app/gen:one)
-- want/missing.txt --
genx: check found 1 problem; run genx:
  missing   zz_one.go (example.com/app/gen:one)
-- want/leftover.txt --
genx: check found 2 problems; run genx:
  leftover  zz_old.go (example.com/app/gen:old wrote it; nothing does now)
  stale     genx.lock
-- want/producer.txt --
cfg: failing: cfg.json is stale
genx: check found 1 problem; run genx:
  producer  producer cfg: fail cfg.json is stale: exit status 3
