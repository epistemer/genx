# genx check renders each generator over what the earlier ones rendered, not
# over the files on disk: an edited domain file a generator emitted is stale,
# and the generator that reads it isn't.
exec genx
exists zz_data.json
exists zz_use.go
exec genx check

cp edited.json zz_data.json
! exec genx check
cmp stderr want/stale.txt

-- genx.yaml --
version: 1
producers:
  - name: cfg
    run: [produce, data/cfg.json, cfg.json]
    emits:
      - path: cfg.json
        domain: cfg/v1
use:
  - example.com/app/gen: [data, use]
-- data/cfg.json --
{"name": "shop"}
-- edited.json --
{"domain": "data/v1", "name": "edited"}
-- gen/gen.go --
package gen
-- gen/genx.meta.yaml --
version: 1
generators:
  data:
    doc: a data file from the config
    needs: [cfg/v1]
    emits: data/v1
    units: '{domain: "data/v1", name: .["cfg/v1"][0].name}'
    out: '"zz_data.json"'
  use:
    doc: Go from the data file
    needs: [data/v1]
    units: '.["data/v1"][0] | {name}'
    out: '"zz_use.go"'
    template: use.tmpl
-- gen/use.tmpl --
// Code generated by test. DO NOT EDIT.

package app

const name = "{{.name}}"
-- want/stale.txt --
genx: check found 1 problem; run genx:
  stale     zz_data.json (example.com/app/gen:data)
