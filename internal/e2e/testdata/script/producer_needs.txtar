# M4.4: a producer that needs a domain runs after the steps that write it,
# even when it comes first in the manifest, on a first run too.
exec genx
stdout -count=1 '^wrote '
exists out/zz_out.consumed.json
grep '"producer": "settings"' out/zz_out.consumed.json

# The generator that reads consumed/v1 ran last.
cmp zz_seen.go want/zz_seen.go

exec genx
! stdout '^wrote '

-- genx.yaml --
version: 1
producers:
  - name: reader
    run: [consume, internal/settings/zz_settings.labels.json, out/zz_out.consumed.json]
    needs: [labels/v1]
    emits: [out/zz_out.consumed.json]
  - name: settings
    run: [produce, data/labels.json, internal/settings/zz_settings.labels.json]
    emits: [internal/settings/zz_settings.labels.json]
use:
  - example.com/app/gen: [seen]
-- out/.keep --
-- gen/gen.go --
package gen
-- gen/genx.meta.yaml --
version: 1

generators:
  seen:
    doc: what the reader saw
    needs: [consumed/v1]
    units: '.["consumed/v1"][0].from | {producer}'
    out: '"zz_seen.go"'
    template: seen.tmpl
-- gen/seen.tmpl --
// Code generated by test. DO NOT EDIT.

package app

// The reader saw a file from {{.producer}}.
-- data/labels.json --
{"domain": "labels/v1", "producer": "settings", "package": {"name": "settings", "dir": "internal/settings"}, "labels": []}
-- want/zz_seen.go --
// Code generated by test. DO NOT EDIT.

package app

// The reader saw a file from settings.
