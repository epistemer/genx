# A use entry the go command can't find gets the blank-import advice.
cp manifests/nowhere.yaml genx.yaml
! exec genx
stderr '^genx: use example.com/nowhere: the go command can''t find this package: '
stderr '^\timport _ "example.com/nowhere"$'
! stdout .

# A package without a metafile.
cp manifests/nometa.yaml genx.yaml
! exec genx
cmp stderr want/nometa.txt

# A generator the metafile doesn't have.
cp manifests/nogen.yaml genx.yaml
! exec genx
cmp stderr want/nogen.txt

-- plain/plain.go --
package plain
-- gen/gen.go --
package gen
-- gen/genx.meta.yaml --
version: 1
generators:
  read:
    doc: reads labels
    needs: [labels/v1]
    units: '{}'
    out: '"zz_out.go"'
    template: ok.tmpl
  write:
    doc: writes labels
    needs: [labels/v1]
    units: '{}'
    out: '"zz_out.go"'
    template: ok.tmpl
-- gen/ok.tmpl --
// Code generated by test. DO NOT EDIT.

package app
-- manifests/nowhere.yaml --
version: 1
use:
  - example.com/nowhere: [labels]
-- manifests/nometa.yaml --
version: 1
use:
  - example.com/app/plain: [labels]
-- manifests/nogen.yaml --
version: 1
use:
  - example.com/app/gen: [labels]
-- want/nometa.txt --
genx: use example.com/app/plain: the package has no genx.meta.yaml, so it ships no generators; name the package that does
-- want/nogen.txt --
genx: use example.com/app/gen: no generator "labels" in its genx.meta.yaml (it has: read, write)
