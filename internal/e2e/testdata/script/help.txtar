# genx help prints the usage and succeeds.
exec genx help
stdout '^genx runs an app''s code generation'
! stderr .

# An unknown command is a usage error, exit code 2.
! exec genx frobnicate
stderr '^genx: unknown command "frobnicate"$'

# The temporary module is in place for later scripts.
exists go.mod
grep '^module example.com/app$' go.mod
