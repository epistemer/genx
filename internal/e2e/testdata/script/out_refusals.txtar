# M3.2: what a generator's out may name. Each case switches on one generator.

# An escape from the module.
cp manifests/dotdot.yaml genx.yaml
! exec genx
cmp stderr want/dotdot.txt

# A name without zz_.
cp manifests/plain.yaml genx.yaml
! exec genx
cmp stderr want/plain.txt

# A dot-directory, such as .git or .github.
cp manifests/dotdir.yaml genx.yaml
! exec genx
cmp stderr want/dotdir.txt

# A Windows reserved name, in any case.
cp manifests/reserved.yaml genx.yaml
! exec genx
cmp stderr want/reserved.txt

# Two generators, one file, compared without case.
cp manifests/clash.yaml genx.yaml
! exec genx
cmp stderr want/clash.txt

# out must give exactly one string.
cp manifests/two.yaml genx.yaml
! exec genx
cmp stderr want/two.txt

# out must give a string.
cp manifests/number.yaml genx.yaml
! exec genx
cmp stderr want/number.txt

# Only A-Z a-z 0-9 . _ - in a path.
cp manifests/space.yaml genx.yaml
! exec genx
cmp stderr want/space.txt

# An absolute path.
cp manifests/abs.yaml genx.yaml
! exec genx
cmp stderr want/abs.txt

# A symlink can't lead a write outside the module.
[!windows] symlink link -> ../outside
[!windows] mkdir ../outside
[!windows] cp manifests/symlink.yaml genx.yaml
[!windows] ! exec genx
[!windows] stderr '^genx: example.com/app/gen:symlink: writing link/zz_x.go: '
[!windows] ! exists ../outside/zz_x.go

# Nothing was written by any failed run.
! exists zz_x.go
! exists zz_A.go

-- gen/gen.go --
package gen
-- gen/genx.meta.yaml --
version: 1

generators:
  dotdot:
    doc: escapes
    needs: [app.config/v1]
    units: '1'
    out: '"a/../../zz_x.go"'
    template: x.tmpl
  plain:
    doc: no prefix
    needs: [app.config/v1]
    units: '1'
    out: '"x.go"'
    template: x.tmpl
  dotdir:
    doc: into .github
    needs: [app.config/v1]
    units: '1'
    out: '".github/workflows/zz_x.yml"'
    template: x.tmpl
  reserved:
    doc: a device name
    needs: [app.config/v1]
    units: '1'
    out: '"aux.d/zz_x.go"'
    template: x.tmpl
  upper:
    doc: one case
    needs: [app.config/v1]
    units: '1'
    out: '"zz_A.go"'
    template: x.tmpl
  lower:
    doc: the other case
    needs: [app.config/v1]
    units: '1'
    out: '"zz_a.go"'
    template: x.tmpl
  two:
    doc: two paths
    needs: [app.config/v1]
    units: '1'
    out: '"zz_x.go", "zz_y.go"'
    template: x.tmpl
  symlink:
    doc: through a link
    needs: [app.config/v1]
    units: '1'
    out: '"link/zz_x.go"'
    template: x.tmpl
  number:
    doc: a number
    needs: [app.config/v1]
    units: '1'
    out: '1'
    template: x.tmpl
  space:
    doc: a space
    needs: [app.config/v1]
    units: '1'
    out: '"zz_a b.go"'
    template: x.tmpl
  abs:
    doc: absolute
    needs: [app.config/v1]
    units: '1'
    out: '"/tmp/zz_x.go"'
    template: x.tmpl
-- gen/x.tmpl --
// Code generated by test. DO NOT EDIT.

package x
-- manifests/dotdot.yaml --
version: 1
producers:
  - name: config
    run: [produce, data/config.json, config.json]
    emits:
      - path: config.json
        domain: app.config/v1
use:
  - example.com/app/gen: [dotdot]
-- manifests/plain.yaml --
version: 1
producers:
  - name: config
    run: [produce, data/config.json, config.json]
    emits:
      - path: config.json
        domain: app.config/v1
use:
  - example.com/app/gen: [plain]
-- manifests/dotdir.yaml --
version: 1
producers:
  - name: config
    run: [produce, data/config.json, config.json]
    emits:
      - path: config.json
        domain: app.config/v1
use:
  - example.com/app/gen: [dotdir]
-- manifests/reserved.yaml --
version: 1
producers:
  - name: config
    run: [produce, data/config.json, config.json]
    emits:
      - path: config.json
        domain: app.config/v1
use:
  - example.com/app/gen: [reserved]
-- manifests/clash.yaml --
version: 1
producers:
  - name: config
    run: [produce, data/config.json, config.json]
    emits:
      - path: config.json
        domain: app.config/v1
use:
  - example.com/app/gen: [upper, lower]
-- manifests/number.yaml --
version: 1
producers:
  - name: config
    run: [produce, data/config.json, config.json]
    emits:
      - path: config.json
        domain: app.config/v1
use:
  - example.com/app/gen: [number]
-- manifests/space.yaml --
version: 1
producers:
  - name: config
    run: [produce, data/config.json, config.json]
    emits:
      - path: config.json
        domain: app.config/v1
use:
  - example.com/app/gen: [space]
-- manifests/abs.yaml --
version: 1
producers:
  - name: config
    run: [produce, data/config.json, config.json]
    emits:
      - path: config.json
        domain: app.config/v1
use:
  - example.com/app/gen: [abs]
-- want/number.txt --
genx: example.com/app/gen:number: out gave a number; it must give a path as a string
-- want/space.txt --
genx: example.com/app/gen:space: out: "zz_a b.go": element "zz_a b.go" contains invalid character ' '
-- want/abs.txt --
genx: example.com/app/gen:abs: out: "/tmp/zz_x.go": must not be absolute
-- manifests/two.yaml --
version: 1
producers:
  - name: config
    run: [produce, data/config.json, config.json]
    emits:
      - path: config.json
        domain: app.config/v1
use:
  - example.com/app/gen: [two]
-- manifests/symlink.yaml --
version: 1
producers:
  - name: config
    run: [produce, data/config.json, config.json]
    emits:
      - path: config.json
        domain: app.config/v1
use:
  - example.com/app/gen: [symlink]
-- data/config.json --
{"name": "demo"}
-- want/dotdot.txt --
genx: example.com/app/gen:dotdot: out: "a/../../zz_x.go": must not contain ".."
-- want/plain.txt --
genx: example.com/app/gen:plain: out: "x.go": the base name must start with zz_
-- want/dotdir.txt --
genx: example.com/app/gen:dotdir: out: ".github/workflows/zz_x.yml": element ".github" must not start with '.'
-- want/reserved.txt --
genx: example.com/app/gen:reserved: out: "aux.d/zz_x.go": "aux" is a reserved name on Windows
-- want/clash.txt --
genx: example.com/app/gen:lower writes zz_a.go, which example.com/app/gen:upper writes too
-- want/two.txt --
genx: example.com/app/gen:two: out gave 2 values for a unit; it must give one path
